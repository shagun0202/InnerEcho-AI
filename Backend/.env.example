ENVIRONMENT=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty only for a local demo; sessions will expire when the API restarts.
SECRET_KEY= 
DATABASE_URL=
FRONTEND_URL=
CORS_ORIGINS=
EMOTION_BACKEND=local
# Optional: install requirements-ai.txt, then use EMOTION_BACKEND=transformer.
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 
GOOGLE_REDIRECT_URI=
TEAM_MIN_SAMPLE=5
GOOGLE_TTS_API_KEY=
